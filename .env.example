# Copy to .env and fill in real values. Never commit .env.
# Used by: docker compose (src/main/docker/app.yml). For Render, set the same keys in the dashboard.

# Required. Base64 string of at least 64 random bytes (HS512). Generate: openssl rand -base64 64 | tr -d '\n'
JHIPSTER_SECURITY_AUTHENTICATION_JWT_BASE64_SECRET=

# Required in prod. Exactly 64 hex chars, must match the key in the MCPHub admin panel.
# Generate: openssl rand -hex 32
MCP_CONTRACT_HMAC_KEY=

# Comma-separated host names (no scheme/path) the hub may redirect back to.
MCP_CONTRACT_ALLOWED_CALLBACK_HOSTS=lockmcp.ai,www.lockmcp.ai

# Optional. Served at /.well-known/mcp-hub-verification.json
MCP_CONTRACT_DOMAIN_VERIFICATION_TOKEN=
